// Node Modules Resolver - resolves bare imports from node_modules
// Follows Node.js/TypeScript module resolution algorithm
//
// Features:
// - Walks up directory tree to find node_modules
// - Parses package.json for types/typings/main fields
// - Supports @types packages (DefinitelyTyped)
// - Handles scoped packages (@scope/package)
// - Discovers .d.ts type definitions

// ============================================================================
// Data Structures
// ============================================================================

///|
/// Result of resolving a module specifier
pub(all) enum ResolvedModule {
  /// Successfully resolved to a file path
  Resolved(String)
  /// Module not found
  NotFound
  /// Package found but no type definitions
  NoTypes(String) // package directory path
}

///|
/// Information about a resolved package
pub(all) struct PackageInfo {
  name : String // package name (e.g., "react", "@types/react")
  directory : String // path to package directory
  types_file : String? // path to types entry (.d.ts)
  main_file : String? // path to main entry (.js)
  version : String? // package version
} derive(Debug)

///|
/// Cache for resolved modules to avoid repeated filesystem lookups
pub(all) struct ModuleResolutionCache {
  entries : Map[String, ResolvedModule] // (from_file + specifier) -> resolution
  package_info : Map[String, PackageInfo] // package_dir -> info
}

///|
/// Create a new module resolution cache
pub fn ModuleResolutionCache::new() -> ModuleResolutionCache {
  { entries: Map([]), package_info: Map([]) }
}

///|
/// Get cache key for a resolution
pub fn get_cache_key(from_file : String, specifier : String) -> String {
  from_file + "|" + specifier
}

// ============================================================================
// Path Utilities
// ============================================================================

///|
/// Get the directory containing a file path
pub fn dirname(path : String) -> String {
  let mut last_slash = -1
  for i = 0; i < path.length(); i = i + 1 {
    if path[i] == '/' || path[i] == '\\' {
      last_slash = i
    }
  }
  if last_slash == -1 {
    "."
  } else if last_slash == 0 {
    "/"
  } else {
    path[:last_slash].to_owned()
  }
}

///|
/// Join two path segments
pub fn join_path(base : String, segment : String) -> String {
  if base.has_suffix("/") {
    base + segment
  } else {
    base + "/" + segment
  }
}

///|
/// Check if a path is a bare specifier (not relative or absolute)
pub fn is_bare_specifier(specifier : String) -> Bool {
  !(specifier.has_prefix(".")) &&
  !(specifier.has_prefix("/")) &&
  !(specifier.contains("://"))
}

///|
/// Check if a package name is scoped (starts with @)
pub fn is_scoped_package(name : String) -> Bool {
  name.has_prefix("@")
}

///|
/// Parse a package specifier into (package_name, subpath)
/// Examples:
///   "lodash" -> ("lodash", None)
///   "lodash/fp" -> ("lodash", Some("fp"))
///   "@scope/pkg" -> ("@scope/pkg", None)
///   "@scope/pkg/lib" -> ("@scope/pkg", Some("lib"))
pub fn parse_package_specifier(specifier : String) -> (String, String?) {
  if is_scoped_package(specifier) {
    // Scoped package: find second slash
    let mut slash_count = 0
    let mut second_slash_pos = -1
    for i = 0; i < specifier.length(); i = i + 1 {
      if specifier[i] == '/' {
        slash_count = slash_count + 1
        if slash_count == 2 {
          second_slash_pos = i
          break
        }
      }
    }
    if second_slash_pos == -1 {
      (specifier, None)
    } else {
      let pkg_name = specifier[:second_slash_pos].to_owned()
      let subpath = specifier[second_slash_pos + 1:].to_owned()
      (pkg_name, Some(subpath))
    }
  } else {
    // Regular package: find first slash
    let mut first_slash_pos = -1
    for i = 0; i < specifier.length(); i = i + 1 {
      if specifier[i] == '/' {
        first_slash_pos = i
        break
      }
    }
    if first_slash_pos == -1 {
      (specifier, None)
    } else {
      let pkg_name = specifier[:first_slash_pos].to_owned()
      let subpath = specifier[first_slash_pos + 1:].to_owned()
      (pkg_name, Some(subpath))
    }
  }
}

// ============================================================================
// Package.json Parsing
// ============================================================================

///|
/// Extract a string field from a simple JSON object
/// This is a simple parser for package.json - handles basic cases
pub fn extract_json_string_field(json : String, field : String) -> String? {
  // Look for "field": "value" pattern
  let pattern = "\"" + field + "\""
  let mut pos = 0
  let json_len = json.length()
  let pattern_len = pattern.length()
  while pos + pattern_len < json_len {
    // Check if pattern matches at current position
    let mut matches = true
    for j = 0; j < pattern_len; j = j + 1 {
      if json[pos + j] != pattern[j] {
        matches = false
        break
      }
    }
    if matches {
      // Found field name, now find the colon and value
      let mut i = pos + pattern_len

      // Skip whitespace
      while i < json_len &&
            (
              json[i] == ' ' ||
              json[i] == '\t' ||
              json[i] == '\n' ||
              json[i] == '\r'
            ) {
        i = i + 1
      }

      // Expect colon
      if i < json_len && json[i] == ':' {
        i = i + 1

        // Skip whitespace
        while i < json_len &&
              (
                json[i] == ' ' ||
                json[i] == '\t' ||
                json[i] == '\n' ||
                json[i] == '\r'
              ) {
          i = i + 1
        }

        // Expect opening quote
        if i < json_len && json[i] == '"' {
          i = i + 1
          let value_start = i

          // Find closing quote (handle escapes)
          while i < json_len {
            if json[i] == '\\' && i + 1 < json_len {
              i = i + 2 // Skip escaped character
            } else if json[i] == '"' {
              // Found end of string
              return Some(json[value_start:i].to_owned())
            } else {
              i = i + 1
            }
          }
        }
      }
    }
    pos = pos + 1
  }
  None
}

///|
/// Parse package.json to extract type-related fields
pub fn parse_package_json(content : String) -> PackageInfo {
  let name = extract_json_string_field(content, "name").unwrap_or("")
  let version = extract_json_string_field(content, "version")
  let types = extract_json_string_field(content, "types")
  let typings = extract_json_string_field(content, "typings")
  let main = extract_json_string_field(content, "main")

  // Priority: types > typings > main (converted to .d.ts)
  let types_file = match (types, typings) {
    (Some(t), _) => Some(t)
    (None, Some(t)) => Some(t)
    (None, None) => None
  }
  PackageInfo::{ name, directory: "", types_file, main_file: main, version }
}

// ============================================================================
// Node Modules Resolution
// ============================================================================

///|
/// Find a package in node_modules by walking up the directory tree
pub async fn find_package_in_node_modules(
  package_name : String,
  from_dir : String,
) -> String? raise Error {
  let mut current_dir = from_dir

  // Walk up the directory tree
  while current_dir.length() > 0 && current_dir != "/" {
    let node_modules_path = join_path(current_dir, "node_modules")
    let package_path = join_path(node_modules_path, package_name)

    // Check if package directory exists
    if @fs.exists(package_path) {
      let file_kind = @fs.kind(package_path)
      if file_kind == @fs.FileKind::Directory {
        return Some(package_path)
      }
    }

    // Move up one directory
    current_dir = dirname(current_dir)
  }
  None
}

///|
/// Try to resolve a file with TypeScript extensions
async fn try_resolve_with_extensions(
  base_path : String,
  typescript_only : Bool,
) -> String? raise Error {
  // TypeScript extensions (prioritized)
  let ts_extensions = [".d.ts", ".ts", ".tsx"]
  let js_extensions = [".js", ".jsx"]

  // Try TypeScript extensions first
  for ext in ts_extensions {
    let path = base_path + ext
    if @fs.exists(path) {
      let kind = @fs.kind(path)
      if kind == @fs.FileKind::Regular {
        return Some(path)
      }
    }
  }

  // Try JavaScript extensions if allowed
  if !(typescript_only) {
    for ext in js_extensions {
      let path = base_path + ext
      if @fs.exists(path) {
        let kind = @fs.kind(path)
        if kind == @fs.FileKind::Regular {
          return Some(path)
        }
      }
    }
  }

  // Try index files if base_path is a directory
  if @fs.exists(base_path) {
    let kind = @fs.kind(base_path)
    if kind == @fs.FileKind::Directory {
      let index_files = ["index.d.ts", "index.ts", "index.tsx"]
      let js_index_files = ["index.js", "index.jsx"]
      for index_file in index_files {
        let path = join_path(base_path, index_file)
        if @fs.exists(path) {
          return Some(path)
        }
      }
      if !(typescript_only) {
        for index_file in js_index_files {
          let path = join_path(base_path, index_file)
          if @fs.exists(path) {
            return Some(path)
          }
        }
      }
    }
  }
  None
}

///|
/// Resolve the entry point of a package from its package.json
async fn resolve_package_entry(
  package_dir : String,
  subpath : String?,
  typescript_only : Bool,
) -> String? raise Error {
  // If there's a subpath, resolve it directly
  match subpath {
    Some(sub) => {
      let sub_path = join_path(package_dir, sub)
      return try_resolve_with_extensions(sub_path, typescript_only)
    }
    None => ()
  }

  // Read and parse package.json
  let package_json_path = join_path(package_dir, "package.json")
  if !(@fs.exists(package_json_path)) {
    // No package.json, try index files directly
    return try_resolve_with_extensions(package_dir, typescript_only)
  }
  let data = @fs.read_file(package_json_path)
  let content = data.text()
  let info = parse_package_json(content)

  // Try types/typings field first
  match info.types_file {
    Some(types_path) => {
      let full_path = join_path(package_dir, types_path)
      if @fs.exists(full_path) {
        return Some(full_path)
      }
    }
    None => ()
  }

  // Try main field with .d.ts extension
  match info.main_file {
    Some(main_path) => {
      // Convert .js to .d.ts
      let dts_path = if main_path.has_suffix(".js") {
        main_path[:main_path.length() - 3].to_owned() + ".d.ts"
      } else {
        main_path + ".d.ts"
      }
      let full_dts_path = join_path(package_dir, dts_path)
      if @fs.exists(full_dts_path) {
        return Some(full_dts_path)
      }

      // If not typescript_only, try the main file itself
      if !(typescript_only) {
        let full_main_path = join_path(package_dir, main_path)
        if @fs.exists(full_main_path) {
          return Some(full_main_path)
        }
      }
    }
    None => ()
  }

  // Fallback to index files
  try_resolve_with_extensions(package_dir, typescript_only)
}

///|
/// Resolve a bare import specifier to a file path
/// This is the main entry point for node_modules resolution
pub async fn resolve_bare_import(
  specifier : String,
  from_file : String,
  cache : ModuleResolutionCache,
) -> ResolvedModule raise Error {
  // Check cache first
  let cache_key = get_cache_key(from_file, specifier)
  match cache.entries.get(cache_key) {
    Some(result) => return result
    None => ()
  }
  let from_dir = dirname(from_file)
  let (package_name, subpath) = parse_package_specifier(specifier)

  // For non-scoped packages, try @types/<package> first
  if !(is_scoped_package(package_name)) {
    let types_package = "@types/" + package_name
    match find_package_in_node_modules(types_package, from_dir) {
      Some(types_dir) =>
        match resolve_package_entry(types_dir, subpath, true) {
          Some(resolved_path) => {
            let result = ResolvedModule::Resolved(resolved_path)
            cache.entries[cache_key] = result
            return result
          }
          None => ()
        }
      None => ()
    }
  }

  // Try the package itself
  match find_package_in_node_modules(package_name, from_dir) {
    Some(package_dir) => {
      // Try TypeScript files first
      match resolve_package_entry(package_dir, subpath, true) {
        Some(resolved_path) => {
          let result = ResolvedModule::Resolved(resolved_path)
          cache.entries[cache_key] = result
          return result
        }
        None => ()
      }

      // Fall back to JavaScript files
      match resolve_package_entry(package_dir, subpath, false) {
        Some(resolved_path) => {
          let result = ResolvedModule::Resolved(resolved_path)
          cache.entries[cache_key] = result
          return result
        }
        None => {
          let result = ResolvedModule::NoTypes(package_dir)
          cache.entries[cache_key] = result
          return result
        }
      }
    }
    None => {
      let result = ResolvedModule::NotFound
      cache.entries[cache_key] = result
      result
    }
  }
}

///|
/// Get package info for a package directory
pub async fn get_package_info(
  package_dir : String,
  cache : ModuleResolutionCache,
) -> PackageInfo? raise Error {
  // Check cache
  match cache.package_info.get(package_dir) {
    Some(info) => return Some(info)
    None => ()
  }
  let package_json_path = join_path(package_dir, "package.json")
  if !(@fs.exists(package_json_path)) {
    return None
  }
  let data = @fs.read_file(package_json_path)
  let content = data.text()
  let parsed = parse_package_json(content)
  let info = PackageInfo::{
    name: parsed.name,
    directory: package_dir,
    types_file: parsed.types_file,
    main_file: parsed.main_file,
    version: parsed.version,
  }
  cache.package_info[package_dir] = info
  Some(info)
}

// ============================================================================
// Transitive Dependency Discovery
// ============================================================================

///|
/// Discover all type definition files in a node_modules tree
/// Returns a list of (package_name, dts_file_path) pairs
pub async fn discover_node_modules_types(
  project_dir : String,
) -> Array[(String, String)] raise Error {
  let result : Array[(String, String)] = []
  let node_modules_path = join_path(project_dir, "node_modules")
  if !(@fs.exists(node_modules_path)) {
    return result
  }

  // Read node_modules directory
  let entries = @fs.readdir(node_modules_path, include_hidden=false)
  for entry in entries {
    if entry.has_prefix(".") {
      continue
    }
    let package_path = join_path(node_modules_path, entry)
    let file_kind = @fs.kind(package_path)
    if file_kind != @fs.FileKind::Directory {
      continue
    }
    if entry.has_prefix("@") {
      // Scoped packages: read subdirectories
      let scoped_entries = @fs.readdir(package_path, include_hidden=false)
      for scoped_entry in scoped_entries {
        if scoped_entry.has_prefix(".") {
          continue
        }
        let scoped_package_path = join_path(package_path, scoped_entry)
        let scoped_kind = @fs.kind(scoped_package_path)
        if scoped_kind == @fs.FileKind::Directory {
          let scoped_name = entry + "/" + scoped_entry
          match discover_package_types(scoped_package_path) {
            Some(dts_path) => result.push((scoped_name, dts_path))
            None => ()
          }
        }
      }
    } else {
      // Regular package
      match discover_package_types(package_path) {
        Some(dts_path) => result.push((entry, dts_path))
        None => ()
      }
    }
  }
  result
}

///|
/// Discover type definition file for a single package
async fn discover_package_types(package_dir : String) -> String? raise Error {
  let package_json_path = join_path(package_dir, "package.json")
  if !(@fs.exists(package_json_path)) {
    // Try index.d.ts directly
    let index_dts = join_path(package_dir, "index.d.ts")
    if @fs.exists(index_dts) {
      return Some(index_dts)
    }
    return None
  }
  let data = @fs.read_file(package_json_path)
  let content = data.text()
  let info = parse_package_json(content)

  // Check types/typings field
  match info.types_file {
    Some(types_path) => {
      let full_path = join_path(package_dir, types_path)
      if @fs.exists(full_path) {
        return Some(full_path)
      }
    }
    None => ()
  }

  // Check main field with .d.ts
  match info.main_file {
    Some(main_path) => {
      let dts_path = if main_path.has_suffix(".js") {
        main_path[:main_path.length() - 3].to_owned() + ".d.ts"
      } else {
        main_path + ".d.ts"
      }
      let full_dts_path = join_path(package_dir, dts_path)
      if @fs.exists(full_dts_path) {
        return Some(full_dts_path)
      }
    }
    None => ()
  }

  // Fallback: check for index.d.ts
  let index_dts = join_path(package_dir, "index.d.ts")
  if @fs.exists(index_dts) {
    return Some(index_dts)
  }
  None
}

///|
/// Resolve multiple bare imports in parallel
pub async fn resolve_bare_imports_batch(
  specifiers : Array[(String, String)], // (specifier, from_file) pairs
  cache : ModuleResolutionCache,
) -> Array[ResolvedModule] raise Error {
  if specifiers.length() == 0 {
    return []
  }

  // Pre-allocate results
  let results : Array[ResolvedModule?] = Array::make(specifiers.length(), None)

  // Use semaphore for concurrency control
  let sem = @semaphore.Semaphore(16)
  @async.with_task_group(fn(group) {
    for i = 0; i < specifiers.length(); i = i + 1 {
      let idx = i
      let (specifier, from_file) = specifiers[i]
      let _ = group.spawn(async fn() {
        sem.acquire()
        let result = resolve_bare_import(specifier, from_file, cache)
        results[idx] = Some(result)
        sem.release()
      })

    }
  })

  // Convert to final array
  let final_results : Array[ResolvedModule] = []
  for result in results {
    match result {
      Some(r) => final_results.push(r)
      None => final_results.push(ResolvedModule::NotFound)
    }
  }
  final_results
}
