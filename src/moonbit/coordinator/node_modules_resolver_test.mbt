// Tests for Node Modules Resolver

// ============================================================================
// Path Utilities Tests
// ============================================================================

///|
test "dirname - basic path" {
  assert_eq(dirname("/foo/bar/baz.ts"), "/foo/bar")
}

///|
test "dirname - root file" {
  assert_eq(dirname("/file.ts"), "/")
}

///|
test "dirname - simple file" {
  assert_eq(dirname("file.ts"), ".")
}

///|
test "dirname - nested path" {
  assert_eq(dirname("/a/b/c/d/e.ts"), "/a/b/c/d")
}

///|
test "join_path - basic join" {
  assert_eq(join_path("/foo/bar", "baz.ts"), "/foo/bar/baz.ts")
}

///|
test "join_path - with trailing slash" {
  assert_eq(join_path("/foo/bar/", "baz.ts"), "/foo/bar/baz.ts")
}

///|
test "is_bare_specifier - bare import" {
  assert_true(is_bare_specifier("react"))
  assert_true(is_bare_specifier("lodash"))
  assert_true(is_bare_specifier("@types/react"))
  assert_true(is_bare_specifier("@scope/package"))
}

///|
test "is_bare_specifier - relative import" {
  assert_true(!(is_bare_specifier("./foo")))
  assert_true(!(is_bare_specifier("../bar")))
  assert_true(!(is_bare_specifier("../../baz")))
}

///|
test "is_bare_specifier - absolute import" {
  assert_true(!(is_bare_specifier("/foo/bar")))
}

///|
test "is_scoped_package - scoped" {
  assert_true(is_scoped_package("@types/react"))
  assert_true(is_scoped_package("@scope/package"))
  assert_true(is_scoped_package("@angular/core"))
}

///|
test "is_scoped_package - not scoped" {
  assert_true(!(is_scoped_package("react")))
  assert_true(!(is_scoped_package("lodash")))
}

// ============================================================================
// Package Specifier Parsing Tests
// ============================================================================

///|
test "parse_package_specifier - simple package" {
  let (name, subpath) = parse_package_specifier("lodash")
  assert_eq(name, "lodash")
  assert_true(subpath is None)
}

///|
test "parse_package_specifier - package with subpath" {
  let (name, subpath) = parse_package_specifier("lodash/fp")
  assert_eq(name, "lodash")
  assert_eq(subpath, Some("fp"))
}

///|
test "parse_package_specifier - package with deep subpath" {
  let (name, subpath) = parse_package_specifier("lodash/fp/map")
  assert_eq(name, "lodash")
  assert_eq(subpath, Some("fp/map"))
}

///|
test "parse_package_specifier - scoped package" {
  let (name, subpath) = parse_package_specifier("@types/react")
  assert_eq(name, "@types/react")
  assert_true(subpath is None)
}

///|
test "parse_package_specifier - scoped package with subpath" {
  let (name, subpath) = parse_package_specifier("@angular/core/testing")
  assert_eq(name, "@angular/core")
  assert_eq(subpath, Some("testing"))
}

///|
test "parse_package_specifier - scoped package with deep subpath" {
  let (name, subpath) = parse_package_specifier("@scope/pkg/lib/utils")
  assert_eq(name, "@scope/pkg")
  assert_eq(subpath, Some("lib/utils"))
}

// ============================================================================
// Package.json Parsing Tests
// ============================================================================

///|
test "parse_package_json - with types field" {
  let json =
    #|{
    #|  "name": "my-package",
    #|  "version": "1.0.0",
    #|  "types": "./dist/index.d.ts",
    #|  "main": "./dist/index.js"
    #|}
  let info = parse_package_json(json)
  assert_eq(info.name, "my-package")
  assert_eq(info.version, Some("1.0.0"))
  assert_eq(info.types_file, Some("./dist/index.d.ts"))
  assert_eq(info.main_file, Some("./dist/index.js"))
}

///|
test "parse_package_json - with typings field" {
  let json =
    #|{
    #|  "name": "old-package",
    #|  "typings": "./types.d.ts"
    #|}
  let info = parse_package_json(json)
  assert_eq(info.name, "old-package")
  assert_eq(info.types_file, Some("./types.d.ts"))
}

///|
test "parse_package_json - types takes priority over typings" {
  let json =
    #|{
    #|  "name": "test-pkg",
    #|  "types": "./types/index.d.ts",
    #|  "typings": "./old-types.d.ts"
    #|}
  let info = parse_package_json(json)
  assert_eq(info.types_file, Some("./types/index.d.ts"))
}

///|
test "parse_package_json - main only" {
  let json =
    #|{
    #|  "name": "js-package",
    #|  "main": "lib/index.js"
    #|}
  let info = parse_package_json(json)
  assert_eq(info.name, "js-package")
  assert_true(info.types_file is None)
  assert_eq(info.main_file, Some("lib/index.js"))
}

///|
test "parse_package_json - minimal" {
  let json =
    #|{
    #|  "name": "minimal"
    #|}
  let info = parse_package_json(json)
  assert_eq(info.name, "minimal")
  assert_true(info.version is None)
  assert_true(info.types_file is None)
  assert_true(info.main_file is None)
}

///|
test "parse_package_json - empty object" {
  let json = "{}"
  let info = parse_package_json(json)
  assert_eq(info.name, "")
  assert_true(info.version is None)
}

// ============================================================================
// extract_json_string_field Tests
// ============================================================================

///|
test "extract_json_string_field - simple field" {
  let json = "{\"name\": \"test\"}"
  let result = extract_json_string_field(json, "name")
  assert_eq(result, Some("test"))
}

///|
test "extract_json_string_field - field not found" {
  let json = "{\"name\": \"test\"}"
  let result = extract_json_string_field(json, "version")
  assert_true(result is None)
}

///|
test "extract_json_string_field - with path value" {
  let json = "{\"types\": \"./dist/index.d.ts\"}"
  let result = extract_json_string_field(json, "types")
  assert_eq(result, Some("./dist/index.d.ts"))
}

///|
test "extract_json_string_field - multiple fields" {
  let json = "{\"a\": \"1\", \"b\": \"2\", \"c\": \"3\"}"
  assert_eq(extract_json_string_field(json, "a"), Some("1"))
  assert_eq(extract_json_string_field(json, "b"), Some("2"))
  assert_eq(extract_json_string_field(json, "c"), Some("3"))
}

///|
test "extract_json_string_field - with whitespace" {
  let json = "{  \"name\"  :  \"test\"  }"
  let result = extract_json_string_field(json, "name")
  assert_eq(result, Some("test"))
}

///|
test "extract_json_string_field - with newlines" {
  let json =
    #|{
    #|  "name": "test"
    #|}
  let result = extract_json_string_field(json, "name")
  assert_eq(result, Some("test"))
}

// ============================================================================
// Cache Tests
// ============================================================================

///|
test "module_resolution_cache - new is empty" {
  let cache = ModuleResolutionCache::new()
  assert_eq(cache.entries.length(), 0)
  assert_eq(cache.package_info.length(), 0)
}

///|
test "get_cache_key - creates unique keys" {
  let key1 = get_cache_key("/a/b.ts", "react")
  let key2 = get_cache_key("/a/b.ts", "lodash")
  let key3 = get_cache_key("/c/d.ts", "react")
  assert_true(key1 != key2)
  assert_true(key1 != key3)
  assert_true(key2 != key3)
}

///|
test "get_cache_key - same inputs same key" {
  let key1 = get_cache_key("/a/b.ts", "react")
  let key2 = get_cache_key("/a/b.ts", "react")
  assert_eq(key1, key2)
}

// ============================================================================
// ResolvedModule Tests
// ============================================================================

///|
test "resolved_module - resolved variant" {
  let result = ResolvedModule::Resolved("/node_modules/react/index.d.ts")
  match result {
    Resolved(path) => assert_eq(path, "/node_modules/react/index.d.ts")
    _ => assert_true(false)
  }
}

///|
test "resolved_module - not_found variant" {
  let result : ResolvedModule = NotFound
  match result {
    NotFound => assert_true(true)
    _ => assert_true(false)
  }
}

///|
test "resolved_module - no_types variant" {
  let result = ResolvedModule::NoTypes("/node_modules/some-pkg")
  match result {
    NoTypes(dir) => assert_eq(dir, "/node_modules/some-pkg")
    _ => assert_true(false)
  }
}

// ============================================================================
// is_typescript_file and is_declaration_file Tests (from file_discovery)
// ============================================================================

///|
test "file extensions - typescript files" {
  assert_true(is_typescript_file("/src/app.ts"))
  assert_true(is_typescript_file("/src/component.tsx"))
  assert_true(!(is_typescript_file("/src/types.d.ts")))
  assert_true(!(is_typescript_file("/src/index.js")))
}

///|
test "file extensions - declaration files" {
  assert_true(is_declaration_file("/types/index.d.ts"))
  assert_true(is_declaration_file("react.d.ts"))
  assert_true(!(is_declaration_file("app.ts")))
  assert_true(!(is_declaration_file("app.tsx")))
}

///|
test "file extensions - any typescript" {
  assert_true(is_any_typescript_file("/src/app.ts"))
  assert_true(is_any_typescript_file("/src/types.d.ts"))
  assert_true(is_any_typescript_file("component.tsx"))
  assert_true(!(is_any_typescript_file("index.js")))
}

// ============================================================================
// Scoped-name mangling and empty package.json fields
// ============================================================================

///|
test "mangle_scoped_name - scoped packages" {
  assert_eq(mangle_scoped_name("@be/bop"), "be__bop")
  assert_eq(mangle_scoped_name("@angular/core"), "angular__core")
}

///|
test "mangle_scoped_name - unscoped unchanged" {
  assert_eq(mangle_scoped_name("lodash"), "lodash")
  assert_eq(mangle_scoped_name("react"), "react")
}

///|
test "parse_package_json - empty string fields treated as absent" {
  let json =
    #|{
    #|  "name": "pkg",
    #|  "types": "",
    #|  "main": ""
    #|}
  let info = parse_package_json(json)
  assert_true(info.types_file is None)
  assert_true(info.main_file is None)
}
